%%{init: {"flowchart": {"rankSpacing": 30, "padding": 10}} }%%
flowchart LR
    START(["Author<br/>unique ID"]) --> MS1

    subgraph MS1["Metrics Service"]
      A1["Fetch data tree"]
    end

    subgraph AS["Author Service"]
      B3["Fetch papers<br/>(paginated)"]
    end

    subgraph PS["Publication Service"]
