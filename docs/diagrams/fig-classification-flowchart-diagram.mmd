    N1 -.- AS
    N1 -.- PS

    classDef plain fill:#ffffff,stroke:#33365c,stroke-width:2px,color:#1f2430
    class A1,B3,C1,D1,D2,START,N1 plain
    style MS1 fill:#fdf0fd,stroke:#d9b3e6,color:#1f2430
    style AS fill:#fdf6ea,stroke:#e0b36a,color:#1f2430
    style PS fill:#eafaf3,stroke:#7fd4c1,color:#1f2430
    style CS1 fill:#eafaf3,stroke:#7fd4c1,color:#1f2430
