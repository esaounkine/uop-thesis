%%{init: {"flowchart": {"rankSpacing": 20, "padding": 10}} }%%
graph LR
  lookup["Look up<br/>results in Cache"] --> hit{"Cached results<br/>exist and are<br/>within TTL?"}
  hit -->|"No"| send["Send<br/>request"]
  send --> recv["Receive<br/> response"]
  recv --> ok{"Is response<br/> status code <br/>< 400"}
  ok -->|"Yes"| store["Store results<br/> in Cache"]
  store --> ret["Return<br/>response"]
  ok -->|"No"| ret
  hit -->|"Yes"| ret

  classDef plain fill:#ffffff,stroke:#33365c,stroke-width:2px,color:#1f2430
  class lookup,hit,send,recv,ok,store,ret plain
