flowchart TB
  subgraph FE["Frontend"]
    direction LR
    PAGES["Pages"] --> CONT["Containers"] --> COMP["Components"]
  end
  subgraph BE["Backend"]
    direction LR
    CTRL["Controllers"] --> SVC["Services"]
    SVC --> REPO["Repositories"]
    SVC --> CONN["Connectors<br/>(HTTP client)"]
    REPO --> DB[("SQLite database")]
    REPO -->|"cached responses"| CONN
  end
  subgraph EXT["External"]
    direction LR
    PROV["Provider API"]
  end

  FE <-->|"request / response"| BE
  BE <-->|"request / response"| EXT

  classDef plain fill:#ffffff,stroke:#33365c,stroke-width:2px,color:#1f2430
  class PAGES,CONT,COMP,CTRL,SVC,CONN,REPO,PROV plain
  style FE fill:#fdf0fd,stroke:#d9b3e6,color:#1f2430
  style BE fill:#fdf0fd,stroke:#d9b3e6,color:#1f2430
  style EXT fill:#ffffff,stroke:#d9b3e6,color:#1f2430
