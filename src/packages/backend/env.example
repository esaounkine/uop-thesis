# Copy this file as .env in your environment and populate the values

DB_FILE=db-data/thesis.sqlite

# HTTP API
PORT=3000
CORS_ORIGIN=*

# Comma-separated providers to use for the search concurrently
PROVIDERS=openalex,semanticscholar

OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_API_KEY=
OPENALEX_MAX_PER_SECOND=

SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_MAX_PER_SECOND=

SEARCH_TTL_MS=
DIRECT_FETCH_TTL_MS=
HTTP_MAX_RETRIES=
HTTP_RETRY_BASE_MS=